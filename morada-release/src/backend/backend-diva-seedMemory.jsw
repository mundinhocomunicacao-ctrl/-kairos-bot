    },
    {
        title: "MAPA_MESTRE::DIVA_MORADA_WIX",
        description: "Instância da DIVA no Wix (ID 7aff6327-39c6-4be0-aa3f-5d50680eb337) com Velo ativo e rotas HTTP",
        surface: "WIX_STUDIO_VELO",
        source: "DIVA_MORADA_SPECS",
        evidence: "Integração Velo + Pipedream + Slack (#diva-command)",
        status: "ENTREGUE_E_COMPROVADO",
        receiptId: "rcpt_morada_wix_20260923",
        timestamp: new Date().toISOString(),
        readbackStatus: "VERIFIED_PASS"
    },
    {
        title: "MAPA_MESTRE::8_ELOS_CORPO",
        description: "Os 8 Elos do Corpo Operacional: DNA -> Esqueleto -> Memória -> Sentidos -> Cérebro -> Sistema Nervoso -> Músculos -> Sistema Imune",
        surface: "MALHA_MUNDINHO",
        source: "CORPO_OPERACIONAL_DIVA",
        evidence: "Mapeamento dos 8 elos do ecossistema",
        status: "ENTREGUE_E_COMPROVADO",
