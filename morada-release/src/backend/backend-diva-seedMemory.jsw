    },
    {
        title: "MAPA_MESTRE::MACROAREAS_MUNDO",
        description: "As 9 Macroáreas do MUNDO: 00_PORTAL, 01_CODICE, 02_OLIMPO, 03_FORJA, 04_RADAR, 05_NEXO, 06_MIDAS, 07_RELICARIO, 08_BASTIDORES",
        surface: "GOOGLE_DRIVE_MUNDO",
        source: "MAPA_MESTRE_CANONICO",
