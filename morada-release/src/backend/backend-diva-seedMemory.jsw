        readbackStatus: "VERIFIED_PASS"
    },
    {
        title: "MAPA_MESTRE::MUNDINHO_OS_NAVIGATION",
        description: "Mundinho OS (Wix Studio): Início, Radar, Agenda, Pipeline, Contatos, Workspace, Explorer, Configurações",
        surface: "WIX_FRONTEND_OS",
        source: "MUNDINHO_OS_V1",
        evidence: "Estrutura de telas do painel de controle no Wix",
        status: "ENTREGUE_E_COMPROVADO",
        receiptId: "rcpt_mundinho_os_20260923",
        timestamp: new Date().toISOString(),
        readbackStatus: "VERIFIED_PASS"
    }
];

export async function injectAndVerifyMapaMestreSeed() {
    const results = [];

    for (const item of MAPA_MESTRE_SEED) {
        try {
            // 1. Gravação na coleção DIVA_MEMORY_WRITEBACK_V1
            const inserted = await wixData.insert("DIVA_MEMORY_WRITEBACK_V1", item);

            // 2. Readback de verificação imediata
            const verified = await wixData.get("DIVA_MEMORY_WRITEBACK_V1", inserted._id);

            if (verified && verified._id) {
                verified.readbackStatus = "VERIFIED_PASS";
                await wixData.update("DIVA_MEMORY_WRITEBACK_V1", verified);

                results.push({
                    title: item.title,
                    receiptId: item.receiptId,
                    status: "VERIFIED_PASS",
                    id: verified._id
                });
            }
        } catch (error) {
            console.error(`Erro ao injetar ${item.title}:`, error);
            results.push({
                title: item.title,
                status: "FAILED",
                error: error.message
            });
        }
    }

    return {
        success: true,
        summary: `Injeção concluída: ${results.length} blocos processados na memória da DIVA.`,
        details: results
    };
}